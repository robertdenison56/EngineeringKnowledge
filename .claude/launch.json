{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ekg-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@ekg/web"],
      "port": 3000
    },
    {
      "name": "ekg-web-ephemeral",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@ekg/web"],
      "port": 3100,
      "env": { "EKG_DB_PATH": ":memory:", "PORT": "3100" }
    },
    {
      "name": "ekg-web-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@ekg/web"],
      "port": 3200,
      "env": {
        "EKG_DB_PATH": "/Volumes/RobertsExternalSSD/repos/EngineeringKnowledge/apps/web/.data/test-ekg.db",
        "PORT": "3200"
      }
    },
    {
      "name": "ekg-mcp-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/mcp-server/dist/index.js"]
    }
  ]
}
